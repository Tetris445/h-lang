#!/bin/bash
# hprep — препроцессор для h (вставляет библиотеки)

if [ -z "$1" ]; then
    echo "Usage: hprep <file.h>"
    exit 1
fi

INPUT="$1"
OUTPUT="${INPUT%.h}_pp.h"

> "$OUTPUT" # Очищаем выходной файл

while IFS= read -r line; do
    # Проверяем, начинается ли строка с "use "
    if [[ "$line" =~ ^[[:space:]]*use[[:space:]]+(.+)$ ]]; then
        LIB="${BASH_REMATCH[1]}"
        LIB=$(echo "$LIB" | tr -d '[:space:]') # Убираем пробелы
        if [ -f "$LIB" ]; then
            echo "# --- Included from $LIB ---" >> "$OUTPUT"
            cat "$LIB" >> "$OUTPUT"
            echo "# --- End of $LIB ---" >> "$OUTPUT"
        else
            echo "# ERROR: Library not found: $LIB" >> "$OUTPUT"
        fi
    else
        echo "$line" >> "$OUTPUT"
    fi
done < "$INPUT"

echo "Preprocessed: $OUTPUT"
