#!/bin/bash
# hbridge v5.1 — мост для чистого h (bare-metal) с QEMU

case "$1" in
    build)
        shift
        INPUT="$1"
        if [ -z "$INPUT" ]; then echo "Usage: hbridge build <file.h>"; exit 1; fi

        echo "🔄 Компиляция в машинный код..."
        
        # 1. Препроцессинг
        ./hprep "$INPUT"
        PP_FILE="${INPUT%.h}_pp.h"
        
        if [ ! -f "$PP_FILE" ]; then
            echo "❌ Ошибка препроцессинга!"
            exit 1
        fi

        # 2. Генерация C-кода
        ./hcompiler_bare "$PP_FILE" > /dev/null 2>&1
        C_FILE="${PP_FILE%.h}.c"
        BIN_FILE="${INPUT%.h}"

        # 3. Сборка для ARM64 (bare-metal)
        clang --target=aarch64-linux-gnu -nostdlib -nostartfiles -fno-pic -no-pie -nostdinc -T link.ld start.S "$C_FILE" -o "$BIN_FILE" 2>/dev/null

        if [ -f "$BIN_FILE" ]; then
            echo "✅ Готово! Запускаю в QEMU..."
            qemu-system-aarch64 -M virt -cpu cortex-a53 -nographic -kernel "$BIN_FILE"
        else
            echo "❌ Ошибка компиляции!"
            echo "Проверь $C_FILE или $PP_FILE"
        fi
        ;;

    *)
        echo "hbridge v5.1 — мост для чистого h (bare-metal)"
        echo ""
        echo "Использование:"
        echo "  hbridge build <file.h> - Компиляция и запуск в QEMU"
        ;;
esac
